# Use the Render Internal Database URL on the web service.
# For local work, use the External Database URL from the Render Postgres page.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cbh"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional. Public measurement ID, for example G-XXXXXXXX
NEXT_PUBLIC_GA_ID=""
# Optional Maps JavaScript API key. Suburb selection works without it.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
# Optional email alerts via Resend
RESEND_API_KEY=""
NOTIFY_EMAIL=""
NOTIFY_FROM=""
